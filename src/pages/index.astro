---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

// Ler dados do CSV
function readCSV(filePath) {
  const content = fs.readFileSync(filePath, 'utf-8');
  const lines = content.split('\n');
  const headers = lines[0].split(',').map(h => h.trim());

  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    if (!lines[i].trim()) continue;
    const values = lines[i].split(',').map(v => v.trim());
    const row = {};
    headers.forEach((h, idx) => {
      row[h] = values[idx] || '';
    });
    rows.push(row);
  }
  return rows;
}

function parseDate(dateStr) {
  const [day, month, year] = dateStr.split('/');
  return new Date(year, month - 1, day);
}

// Imagem padrão por tema
function getDefaultImage(tema) {
  const images = {
    'Estresse': 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=300&fit=crop',
    'Sono': 'https://images.unsplash.com/photo-1541123603104-852fc75f7404?w=400&h=300&fit=crop',
    'Ansiedade': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=400&h=300&fit=crop',
    'Meditação': 'https://images.unsplash.com/photo-1528148343865-f218b37f5a5c?w=400&h=300&fit=crop',
    'Memória': 'https://images.unsplash.com/photo-1516534775068-bb57c960e9c8?w=400&h=300&fit=crop',
    'Bem-estar': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=400&h=300&fit=crop',
  };
  return images[tema] || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=300&fit=crop';
}

// Carregar artigos
const csvPath = path.join(process.cwd(), 'dados', 'calendario_blog_1_ano.csv');
const allRows = readCSV(csvPath);
const articlesDir = path.join(process.cwd(), 'dados', 'saida', 'html');

// Filtrar artigos que existem
const articles = allRows
  .filter(row => {
    const htmlFile = row['Artigo_Arquivo_HTML'];
    if (!htmlFile || htmlFile.toLowerCase() === 'nan') return false;
    const filePath = path.join(articlesDir, path.basename(htmlFile));
    return fs.existsSync(filePath);
  })
  .sort((a, b) => parseDate(b['Data']).getTime() - parseDate(a['Data']).getTime());

// Artigos que vão publicar
const upcomingArticles = allRows
  .filter(row => {
    const htmlFile = row['Artigo_Arquivo_HTML'];
    if (!htmlFile || htmlFile.toLowerCase() === 'nan') return true;
    const filePath = path.join(articlesDir, path.basename(htmlFile));
    return !fs.existsSync(filePath);
  })
  .sort((a, b) => parseDate(a['Data']).getTime() - parseDate(b['Data']).getTime())
  .slice(0, 6);

const hero1 = articles[0];
const hero2 = articles[1];
const otherArticles = articles.slice(2, 8);
---

<Layout title="Início" description="Blog Mente Leve: artigos informativos sobre ansiedade, estresse, sono, meditação e bem-estar mental.">
  <style>
    .hero {
      display: block;
      text-decoration: none;
      color: inherit;
      background: linear-gradient(135deg, #006400, #0a7d0a);
      border-radius: 0;
      overflow: hidden;
      margin: 0 0 40px 0;
      box-shadow: 0 8px 24px rgba(0, 100, 0, 0.2);
    }

    .hero-body {
      padding: 60px 40px;
    }

    .hero .badge {
      display: inline-block;
      background: #ffd54d;
      color: #333;
      font-size: 0.85rem;
      font-weight: bold;
      padding: 6px 14px;
      border-radius: 20px;
      margin-bottom: 16px;
    }

    .hero-title {
      color: #fff;
      font-size: 2.8rem;
      margin: 0 0 16px;
      line-height: 1.2;
      font-weight: bold;
    }

    .hero-desc {
      color: #e8f3e8;
      font-size: 1.2rem;
      margin: 0 0 20px;
      max-width: 700px;
      line-height: 1.6;
    }

    .hero-meta {
      color: #cfe6cf;
      font-size: 1rem;
    }

    .hero-2 {
      background: linear-gradient(135deg, #1a5f1a, #006400);
      margin: 0 0 50px 0;
    }

    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .section-title {
      color: #006400;
      font-size: 1.8rem;
      font-weight: bold;
      margin: 50px 0 30px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid #e0e8e0;
    }

    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
      margin-bottom: 50px;
    }

    .article-card {
      background: #fff;
      border: 1px solid #e4ece4;
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .article-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 100, 0, 0.15);
    }

    .article-image {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #f0f0f0;
    }

    .article-content {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .article-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      font-size: 0.8rem;
    }

    .article-tag {
      background: #e8f3e8;
      color: #006400;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 3px 10px;
      border-radius: 12px;
      white-space: nowrap;
    }

    .article-date {
      color: #777;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .article-title {
      color: #006400;
      font-size: 1.15rem;
      font-weight: bold;
      margin: 0 0 10px;
      line-height: 1.3;
    }

    .article-desc {
      color: #555;
      font-size: 0.9rem;
      line-height: 1.5;
      margin: 0;
      flex: 1;
    }

    .article-card.coming-soon {
      opacity: 0.7;
    }

    .article-card.coming-soon .article-image {
      opacity: 0.6;
    }

    .article-card.coming-soon .article-desc {
      font-style: italic;
      color: #999;
    }

    .footer-text {
      color: #555;
      font-size: 0.95rem;
      margin: 30px 0;
      text-align: center;
    }

    @media (max-width: 768px) {
      .hero-body {
        padding: 40px 20px;
      }

      .hero-title {
        font-size: 2rem;
      }

      .hero-desc {
        font-size: 1rem;
      }

      .hero {
        margin: 0 0 30px 0;
      }

      .hero-2 {
        margin: 0 0 40px 0;
      }

      .wrap {
        padding: 0 20px;
      }

      .section-title {
        font-size: 1.4rem;
        margin: 30px 0 20px 0;
      }

      .articles-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 30px;
      }
    }
  </style>

  <!-- BANNER HERO 1 (DESTAQUE PRINCIPAL) -->
  {hero1 && (
    <a class="hero" href={`/${path.basename(hero1['Artigo_Arquivo_HTML'])}`}>
      <div class="hero-body">
        <span class="badge">★ Em destaque · {hero1['Tema']}</span>
        <h1 class="hero-title">{hero1['Palavra-chave principal']}</h1>
        <p class="hero-desc">Artigo informativo sobre {hero1['Palavra-chave principal'].toLowerCase()}. Tema: {hero1['Tema']}.</p>
        <span class="hero-meta">📅 Publicado em {hero1['Data']} às {hero1['Horário']}</span>
      </div>
    </a>
  )}

  <!-- BANNER HERO 2 (DESTAQUE SECUNDÁRIO) -->
  {hero2 && (
    <a class="hero hero-2" href={`/${path.basename(hero2['Artigo_Arquivo_HTML'])}`}>
      <div class="hero-body">
        <span class="badge">📌 Recomendado · {hero2['Tema']}</span>
        <h2 class="hero-title">{hero2['Palavra-chave principal']}</h2>
        <p class="hero-desc">Artigo sobre {hero2['Palavra-chave principal'].toLowerCase()}. Tema: {hero2['Tema']}.</p>
        <span class="hero-meta">📅 Publicado em {hero2['Data']} às {hero2['Horário']}</span>
      </div>
    </a>
  )}

  <div class="wrap">
    <!-- PRÓXIMAS PUBLICAÇÕES -->
    <h2 class="section-title">Próximas publicações</h2>

    <div class="articles-grid">
      {upcomingArticles.map(article => {
        const htmlFile = article['Artigo_Arquivo_HTML'];
        const filePath = htmlFile ? path.join(articlesDir, path.basename(htmlFile)) : '';
        const exists = htmlFile && htmlFile.toLowerCase() !== 'nan' && fs.existsSync(filePath);
        const imageUrl = article['Imagem_Miniatura'] || getDefaultImage(article['Tema']);

        if (exists) {
          return (
            <a class="article-card" href={`/${path.basename(htmlFile)}`}>
              <img src={imageUrl} alt={article['Palavra-chave principal']} class="article-image" />
              <div class="article-content">
                <div class="article-meta">
                  <span class="article-tag">{article['Tema']}</span>
                  <span class="article-date">{article['Data']}</span>
                </div>
                <h3 class="article-title">{article['Palavra-chave principal']}</h3>
                <p class="article-desc">Artigo sobre {article['Palavra-chave principal'].toLowerCase()}.</p>
              </div>
            </a>
          );
        } else {
          return (
            <div class="article-card coming-soon">
              <img src={imageUrl} alt={article['Palavra-chave principal']} class="article-image" />
              <div class="article-content">
                <div class="article-meta">
                  <span class="article-tag">{article['Tema']}</span>
                  <span class="article-date">{article['Data']}</span>
                </div>
                <h3 class="article-title">{article['Palavra-chave principal']}</h3>
                <p class="article-desc">Em breve — {article['Horário']}</p>
              </div>
            </div>
          );
        }
      })}
    </div>

    <p class="footer-text">
      📊 {articles.length} artigo(s) publicado(s) · Este conteúdo é informativo e não substitui a orientação de um profissional.
    </p>
  </div>
</Layout>
