---
import PremiumLayout from '../layouts/PremiumLayout.astro';
import FeaturedHero from '../components/premium/FeaturedHero.astro';
import ThumbCard from '../components/premium/ThumbCard.astro';
import PromoBanner from '../components/premium/PromoBanner.astro';
import { loadArticles } from '../lib/articles.js';

const { published, upcoming, temas } = await loadArticles();

// Destaque: artigo mais recente publicado; sem publicados, o próximo agendado
const featured = published[0] ?? upcoming[0];
const grid = [...published.slice(1), ...upcoming];
---

<PremiumLayout
  title="Modelo Premium"
  description="Blog Mente Leve: artigos informativos sobre ansiedade, estresse, sono, meditação e bem-estar mental."
>
  {featured && <FeaturedHero article={featured} />}

  <section id="artigos" class="mx-auto max-w-7xl px-5 pt-20 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">Biblioteca</p>
        <h2 class="mt-2 text-4xl font-semibold text-ink-900">Leituras para respirar melhor</h2>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tema" data-filter-group>
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-chip rounded-full border border-brand-200 bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition"
        >
          Todos
        </button>
        {temas.map(tema => (
          <button
            type="button"
            data-filter={tema}
            aria-pressed="false"
            class="filter-chip rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 transition hover:border-brand-500"
          >
            {tema}
          </button>
        ))}
      </div>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 xl:grid-cols-3" data-grid>
      {grid.map(article => (
        <div data-tema={article.tema}>
          <ThumbCard article={article} />
        </div>
      ))}
    </div>

    <p class="mt-14 text-center text-sm text-ink-500">
      {published.length} artigo(s) publicado(s) · Conteúdo informativo, não substitui orientação profissional.
    </p>
  </section>

  <div class="mt-24">
    <PromoBanner />
  </div>
</PremiumLayout>

<script>
  const ACTIVE = ['bg-brand-600', 'text-white'];
  const IDLE = ['bg-white', 'text-brand-700'];

  const group = document.querySelector<HTMLElement>('[data-filter-group]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] > [data-tema]');

  group?.addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const filter = btn.dataset.filter!;

    group.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b => {
      const on = b === btn;
      b.setAttribute('aria-pressed', String(on));
      b.classList.remove(...(on ? IDLE : ACTIVE));
      b.classList.add(...(on ? ACTIVE : IDLE));
    });
    cards.forEach(card => {
      card.hidden = filter !== 'all' && card.dataset.tema !== filter;
    });
  });
</script>
