---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

// Ler dados do CSV
function readCSV(filePath) {
  const content = fs.readFileSync(filePath, 'utf-8');
  const lines = content.split('\n');
  const headers = lines[0].split(',').map(h => h.trim());

  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    if (!lines[i].trim()) continue;
    const values = lines[i].split(',').map(v => v.trim());
    const row = {};
    headers.forEach((h, idx) => {
      row[h] = values[idx] || '';
    });
    rows.push(row);
  }
  return rows;
}

function parseDate(dateStr) {
  const [day, month, year] = dateStr.split('/');
  return new Date(year, month - 1, day);
}

// Imagem temática por keyword específica
function getThematicImage(tema, keyword) {
  const keywordLower = keyword.toLowerCase();

  // Mapa detalhado por palavra-chave
  const keywordImages = {
    'estresse': 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&h=400&fit=crop',
    'meditação para dormir': 'https://images.unsplash.com/photo-1541123603104-852fc75f7404?w=600&h=400&fit=crop',
    'memória': 'https://images.unsplash.com/photo-1516534775068-bb57c960e9c8?w=600&h=400&fit=crop',
    'inteligência emocional': 'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&h=400&fit=crop',
    'qualidade de vida': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop',
    'meditação': 'https://images.unsplash.com/photo-1528148343865-f218b37f5a5c?w=600&h=400&fit=crop',
    'mindfulness': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop',
    'ansiedade': 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600&h=400&fit=crop',
    'sono': 'https://images.unsplash.com/photo-1541123603104-852fc75f7404?w=600&h=400&fit=crop',
    'respiração': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop',
    'relaxamento': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop',
    'saúde mental': 'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&h=400&fit=crop',
    'bem-estar': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop',
    'atenção': 'https://images.unsplash.com/photo-1516534775068-bb57c960e9c8?w=600&h=400&fit=crop',
    'foco': 'https://images.unsplash.com/photo-1516534775068-bb57c960e9c8?w=600&h=400&fit=crop',
  };

  // Buscar por palavra-chave específica
  for (const [key, url] of Object.entries(keywordImages)) {
    if (keywordLower.includes(key)) {
      return url;
    }
  }

  // Fallback por tema
  const themeImages = {
    'Estresse': 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&h=400&fit=crop',
    'Sono': 'https://images.unsplash.com/photo-1541123603104-852fc75f7404?w=600&h=400&fit=crop',
    'Ansiedade': 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600&h=400&fit=crop',
    'Meditação': 'https://images.unsplash.com/photo-1528148343865-f218b37f5a5c?w=600&h=400&fit=crop',
    'Memória': 'https://images.unsplash.com/photo-1516534775068-bb57c960e9c8?w=600&h=400&fit=crop',
    'Bem-estar': 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop',
    'Saúde Mental': 'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600&h=400&fit=crop',
  };

  return themeImages[tema] || 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=600&h=400&fit=crop';
}

// Carregar artigos
const csvPath = path.join(process.cwd(), 'dados', 'calendario_blog_1_ano.csv');
const allRows = readCSV(csvPath);
const articlesDir = path.join(process.cwd(), 'dados', 'saida', 'html');

// Filtrar artigos que existem
const articles = allRows
  .filter(row => {
    const htmlFile = row['Artigo_Arquivo_HTML'];
    if (!htmlFile || htmlFile.toLowerCase() === 'nan') return false;
    const filePath = path.join(articlesDir, path.basename(htmlFile));
    return fs.existsSync(filePath);
  })
  .sort((a, b) => parseDate(b['Data']).getTime() - parseDate(a['Data']).getTime());

// Artigos que vão publicar
const upcomingArticles = allRows
  .filter(row => {
    const htmlFile = row['Artigo_Arquivo_HTML'];
    if (!htmlFile || htmlFile.toLowerCase() === 'nan') return true;
    const filePath = path.join(articlesDir, path.basename(htmlFile));
    return !fs.existsSync(filePath);
  })
  .sort((a, b) => parseDate(a['Data']).getTime() - parseDate(b['Data']).getTime())
  .slice(0, 9);

const hero = articles[0];
---

<Layout title="Início" description="Blog Mente Leve: artigos informativos sobre ansiedade, estresse, sono, meditação e bem-estar mental.">
  <style>
    .hero-section {
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      background: linear-gradient(135deg, #006400 0%, #0a7d0a 100%);
      margin-bottom: 60px;
    }

    .hero {
      display: block;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
    }

    .hero-body {
      padding: 80px 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero .badge {
      display: inline-block;
      background: #ffd54d;
      color: #333;
      font-size: 0.9rem;
      font-weight: bold;
      padding: 8px 16px;
      border-radius: 20px;
      margin-bottom: 20px;
    }

    .hero-title {
      color: #fff;
      font-size: 3.2rem;
      margin: 0 0 20px;
      line-height: 1.1;
      font-weight: bold;
    }

    .hero-desc {
      color: #e8f3e8;
      font-size: 1.3rem;
      margin: 0 0 24px;
      max-width: 750px;
      line-height: 1.6;
    }

    .hero-meta {
      color: #cfe6cf;
      font-size: 1.05rem;
    }

    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .section-title {
      color: #006400;
      font-size: 2rem;
      font-weight: bold;
      margin: 60px 0 40px 0;
      padding-bottom: 12px;
      border-bottom: 3px solid #006400;
    }

    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 28px;
      margin-bottom: 60px;
    }

    .article-card {
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.3s, box-shadow 0.3s;
      display: flex;
      flex-direction: column;
      height: 100%;
      box-shadow: 0 4px 12px rgba(0, 100, 0, 0.1);
    }

    .article-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 32px rgba(0, 100, 0, 0.2);
    }

    .article-image {
      width: 100%;
      height: 220px;
      object-fit: cover;
      background: #f0f0f0;
    }

    .article-content {
      padding: 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .article-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
      font-size: 0.8rem;
    }

    .article-tag {
      background: #e8f3e8;
      color: #006400;
      font-size: 0.8rem;
      font-weight: bold;
      padding: 4px 12px;
      border-radius: 14px;
      white-space: nowrap;
    }

    .article-date {
      color: #999;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .article-title {
      color: #006400;
      font-size: 1.25rem;
      font-weight: bold;
      margin: 0 0 12px;
      line-height: 1.3;
    }

    .article-desc {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.5;
      margin: 0;
      flex: 1;
    }

    .article-card.coming-soon {
      opacity: 0.75;
    }

    .article-card.coming-soon .article-image {
      opacity: 0.5;
    }

    .article-card.coming-soon .article-desc {
      font-style: italic;
      color: #999;
    }

    .footer-text {
      color: #777;
      font-size: 0.95rem;
      margin: 40px 0;
      text-align: center;
      padding: 20px 0;
      border-top: 1px solid #e0e8e0;
    }

    @media (max-width: 768px) {
      .hero-body {
        padding: 50px 20px;
      }

      .hero-title {
        font-size: 2.2rem;
      }

      .hero-desc {
        font-size: 1.1rem;
      }

      .wrap {
        padding: 0 20px;
      }

      .section-title {
        font-size: 1.6rem;
        margin: 40px 0 24px 0;
      }

      .articles-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 40px;
      }

      .article-content {
        padding: 16px;
      }

      .article-title {
        font-size: 1.1rem;
      }
    }
  </style>

  <!-- HERO FULL WIDTH -->
  <div class="hero-section">
    {hero && (
      <a class="hero" href={`/${path.basename(hero['Artigo_Arquivo_HTML'])}`}>
        <div class="hero-body">
          <span class="badge">★ Em destaque · {hero['Tema']}</span>
          <h1 class="hero-title">{hero['Palavra-chave principal']}</h1>
          <p class="hero-desc">Artigo informativo sobre {hero['Palavra-chave principal'].toLowerCase()}. Mergulhe neste conteúdo essencial sobre {hero['Tema'].toLowerCase()}.</p>
          <span class="hero-meta">📅 {hero['Data']} às {hero['Horário']}</span>
        </div>
      </a>
    )}
  </div>

  <div class="wrap">
    <!-- PRÓXIMAS PUBLICAÇÕES -->
    <h2 class="section-title">Próximas publicações</h2>

    <div class="articles-grid">
      {upcomingArticles.map(article => {
        const htmlFile = article['Artigo_Arquivo_HTML'];
        const filePath = htmlFile ? path.join(articlesDir, path.basename(htmlFile)) : '';
        const exists = htmlFile && htmlFile.toLowerCase() !== 'nan' && fs.existsSync(filePath);
        const imageUrl = article['Imagem_Miniatura'] || getThematicImage(article['Tema'], article['Palavra-chave principal']);

        if (exists) {
          return (
            <a class="article-card" href={`/${path.basename(htmlFile)}`}>
              <img src={imageUrl} alt={article['Palavra-chave principal']} class="article-image" />
              <div class="article-content">
                <div class="article-meta">
                  <span class="article-tag">{article['Tema']}</span>
                  <span class="article-date">{article['Data']}</span>
                </div>
                <h3 class="article-title">{article['Palavra-chave principal']}</h3>
                <p class="article-desc">Descubra dicas e insights sobre {article['Palavra-chave principal'].toLowerCase()}.</p>
              </div>
            </a>
          );
        } else {
          return (
            <div class="article-card coming-soon">
              <img src={imageUrl} alt={article['Palavra-chave principal']} class="article-image" />
              <div class="article-content">
                <div class="article-meta">
                  <span class="article-tag">{article['Tema']}</span>
                  <span class="article-date">{article['Data']} · {article['Horário']}</span>
                </div>
                <h3 class="article-title">{article['Palavra-chave principal']}</h3>
                <p class="article-desc">Em breve — Fique atento para este artigo especial!</p>
              </div>
            </div>
          );
        }
      })}
    </div>

    <p class="footer-text">
      📊 {articles.length} artigo(s) publicado(s) · Este conteúdo é informativo e não substitui a orientação de um profissional.
    </p>
  </div>
</Layout>
